# =========================================================
# EDUPERÚ - RENDER PRODUCTION ENVIRONMENT
# NO PONGAS SECRETOS EN ESTE ARCHIVO SI LO SUBES A GITHUB.
# Los valores secretos se configuran en Render > Environment.
# =========================================================

NODE_ENV=production
DB_ENGINE=postgres

# En Render usar la INTERNAL Database URL de eduperu-db.
DATABASE_URL=

# Render establece PORT automáticamente.
# No es necesario definir PORT manualmente.

# Auth
JWT_SECRET=

# Correo
EMAIL_MODE=resend
RESEND_API_KEY=
EMAIL_FROM=EduPeru <onboarding@resend.dev>

# Después del primer deploy:
APP_BASE_URL=https://TU-SERVICIO.onrender.com

# TTL
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Opcional / integración externa
PRONABEC_API_KEY=
